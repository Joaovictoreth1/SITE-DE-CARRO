{
  "name": "motornews-terminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:browser && npm run test:firebase",
    "test:unit": "node --experimental-test-coverage --test-coverage-include='src/*.ts' --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 --test tests/*.test.ts",
    "test:browser": "playwright test --project=static",
    "test:firebase": "node tests/with-emulators.js"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "autoprefixer": "10.7.0",
    "eslint": "10.15.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  }
}
